// Scenario 1 (spec 5.3): trading basics. Played and tuned in engine/fes-sim/tests/scenario_s1.rs.
(
    id: "s1_first_venture",
    title: "First Venture",
    intro: "Start in k0n0r0c0v1 with 500 coins and an empty cart. Buy cheap g1_0 here, then take it to k0n0r0c0, one week away. Your first sale pays at least 1.5 times what you paid. After that sale, normal market prices apply.",
    seed: 11,
    start_node: "k0n0r0c0v1",
    start_coins: 500,
    weeks: 20,
    warmup_weeks: 4,
    protected_opening: true,
    objectives: [
        (id: "first_sale", text: "Make a profit on your first sale.", goal: NetProfit(1)),
        (id: "contract", text: "Deliver the tool order to k0n0r0c1.", goal: ContractDone("tools")),
        (id: "triple", text: "Earn 1,000 coins of net profit.", goal: NetProfit(1000)),
    ],
    events: [
        (
            id: "offer",
            trigger: PlayerAt("k0n0r0c0"),
            fallback_week: 3,
            effects: [
                OfferContract(id: "tools", good: "g6_0", quantity: 18, node: "k0n0r0c1",
                    reward: 1500, deadline_week: 12,
                    text: "Deliver {qty} crates of {good} to {dest} by week {deadline}. Promised reward: {reward} coins. Buy the goods in k0n0r0c0, then travel through k0n0r0 to reach the destination."),
            ],
        ),
        (
            id: "warning",
            trigger: Holds(good: "g6_0", quantity: 1),
            fallback_week: 6,
            effects: [
                Dialog("Robbers are waiting on the road from k0n0r0 to k0n0r0c1. Guards reduce the attack chance by 70%. Insurance refunds 80% of lost cargo value. Choose your protection before you leave."),
                Raid(from: "k0n0r0", to: "k0n0r0c1", loss_permille: 500),
            ],
        ),
        (
            id: "delivered",
            trigger: ContractDone("tools"),
            fallback_week: 30,
            effects: [Dialog("Delivery complete. Promised {reward} coins; you received {paid} coins.")],
        ),
    ],
)

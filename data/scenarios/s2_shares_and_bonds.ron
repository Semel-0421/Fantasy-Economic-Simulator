// Scenario 2 (spec 5.4): indirect investment through shares and bonds. Played and tuned in
// engine/fes-sim/tests/scenario_s2.rs. Facility 130 is a tool workshop (g17_5) in k0n0r1c4 owned by
// company group 1; issuer -1 is the nation k0n0. Short selling needs a year of trading on the
// exchange, longer than this scenario, so it is not part of it.
(
    id: "s2_shares_and_bonds",
    title: "Shares and Bonds",
    intro: "You sit at the bank of the town k0n0r0c0 with 10,000 coins and no cargo. Here you can buy shares of the nation's companies and its bonds. A share is worth the company's value: its works, two years of its earnings and its cash, over 100 shares; you may own up to 49 of a company. Your score is your wealth at the end: coins, deposits, shares at their price and bonds at face.",
    seed: 22,
    start_node: "k0n0r0c0",
    start_coins: 10000,
    weeks: 22,
    warmup_weeks: 4,
    objectives: [
        (id: "first_thousand", text: "Make 1,000 coins of profit.", goal: NetProfit(1000)),
        (id: "investor", text: "Make 2,500 coins of profit.", goal: NetProfit(2500)),
    ],
    events: [
        (id: "listing", trigger: Week(1), effects: [
            Dialog("Listed at the bank: the tool workshop of k0n0r1c4 (facility 130) sells shares at about 85 coins. Its traders say a large order may be coming."),
        ]),
        (id: "orders", trigger: Week(3), effects: [
            CompanyOrders(facility: 130, coins: 6000, text: "The workshop of k0n0r1c4 has won 6,000 coins of orders. Its cash, and with it its share price, jumps."),
        ]),
        (id: "dividend", trigger: Week(5), effects: [
            Dividend(facility: 130, per_share: 10, text: "The workshop pays a dividend of 10 coins a share."),
        ]),
        (id: "rumour", trigger: Week(7), effects: [
            Dialog("Rumour at the bank: the workshop of k0n0r1c4 has lost a ship of its tools. If it is true, its cash is gone. Shareholders who sell this week still get today's price."),
        ]),
        (id: "losses", trigger: Week(8), effects: [
            CompanyNews(facility: 130, percent: 5, text: "Confirmed: the workshop of k0n0r1c4 lost 95% of its cash. Its shares fall back to the value of its works."),
        ]),
        (id: "bonds", trigger: Week(9), effects: [
            BondIssue(issuer: -1, text: "The nation k0n0 sells bonds at its bank: 4% a year, paid weekly into your deposit, and a special 8% coupon in week 17 for holders. Bonds count at face."),
        ]),
        (id: "coupon", trigger: Week(17), effects: [
            Coupon(issuer: -1, percent: 8, text: "The nation k0n0 pays its special 8% coupon."),
        ]),
        (id: "closing", trigger: Week(20), effects: [
            Dialog("Two weeks remain. Your score counts shares at their price and bonds at face, so you need not sell."),
        ]),
    ],
)

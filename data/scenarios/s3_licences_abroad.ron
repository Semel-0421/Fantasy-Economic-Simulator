// Scenario 3 (spec 5.5): licences and trade between nations. Played and tuned in
// engine/fes-sim/tests/scenario_s3.rs. The full-scale world has no sea routes or ports, so the
// voyage is overland to the neighbouring nation k0n1 through the continent's hub k0; licences are
// sold at every town in this scenario (licences_anywhere) so the trip fits its weeks.
(
    id: "s3_licences_abroad",
    title: "Licences and Trade Abroad",
    intro: "Start in k0n0r0 with 30,000 coins. Buy g19_0 here and sell it in k0n1, where it is scarce. First buy the international trade licence here for 300 coins. Travel through k0n0 and k0 to k0n1, then buy that nation's licence for g19_0 before you sell. Return to k0n0r0 by week 24.",
    seed: 33,
    start_node: "k0n0r0",
    start_coins: 30000,
    weeks: 24,
    warmup_weeks: 4,
    licences_anywhere: true,
    licensed: [(good: "g19_0", nation: "k0n1")],
    objectives: [
        (id: "sold_abroad", text: "Earn your first coin of net profit.", goal: NetProfit(1)),
        (id: "profit", text: "Earn 1,000 coins of net profit after licence costs.", goal: NetProfit(1000)),
        (id: "home", text: "Return to k0n0r0 by week 24.", goal: BackAt(node: "k0n0r0", after: "abroad")),
    ],
    events: [
        (id: "shortage", trigger: Week(1), effects: [
            PriceShock(node: "k0n1", good: "g19_0", percent: 1000, weeks: 20, text: "k0n1 is short of g19_0 and will pay much more for it over the next few weeks. Traders have limited cash: expect to sell about 40 units a week."),
        ]),
        (id: "road_warning", trigger: PlayerAt("k0"), fallback_week: 12, effects: [
            Dialog("Robbers are watching the road from k0 to k0n1. Guards reduce the attack chance by 70%. Insurance refunds 80% of lost cargo value."),
            Raid(from: "k0", to: "k0n1", loss_permille: 500),
        ]),
        (id: "abroad", trigger: PlayerAt("k0n1"), fallback_week: 99, effects: [
            Dialog("Buy the k0n1 licence for g19_0 before selling. Traders cannot buy this good from you without it."),
        ]),
    ],
)

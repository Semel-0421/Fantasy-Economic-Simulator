{
  "name": "fantasy-economic-simulator-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare.mjs",
    "wasm": "node scripts/prepare.mjs --force",
    "dev": "npm run prepare:assets && vite",
    "lint": "eslint .",
    "typecheck": "npm run prepare:assets && tsc --noEmit",
    "test": "npm run prepare:assets && vitest run",
    "build": "npm run prepare:assets && tsc --noEmit && vite build",
    "smoke": "node scripts/smoke.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "assets:log": "node scripts/assets-log.mjs",
    "capture": "node --experimental-strip-types scripts/capture.mjs",
    "test:ui": "npm run prepare:assets && vitest run --config vitest.ui.config.ts",
    "maps:samples": "npm run prepare:assets && node scripts/map-samples.mjs",
    "deadcode": "knip",
    "dup": "jscpd --config .jscpd.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.30.1",
    "@types/node": "22.15.32",
    "binaryen": "123.0.0",
    "eslint": "9.30.1",
    "eslint-plugin-sonarjs": "^2.0.4",
    "fake-indexeddb": "6.2.7",
    "globals": "^16.2.0",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "playwright": "1.53.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "pixi.js": "8.10.2"
  }
}
